# Secrets and local environment
.env
.env.*
!.env.example
*.key

# Claude Code: agent definitions are tracked; worktrees and local settings are not
.claude/worktrees/
.claude/settings.local.json

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter cache
.ipynb_checkpoints/

# macOS and editor metadata
.DS_Store
.vscode/
.idea/

# Local virtual environments
.venv/
venv/
env/

# Local caches and logs
outputs/cache/
outputs/logs/
*.log

# Local generated artifacts
outputs/*
!outputs/.gitkeep
results/*
!results/.gitkeep

# LaTeX build intermediates
docs/build/
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.xdv

# Private lab data (keep local, never commit)
data/raw/
data/lab/
data/processed/
data/reference/
!data/raw/.gitkeep
!data/lab/.gitkeep
!data/processed/.gitkeep
!data/reference/.gitkeep
