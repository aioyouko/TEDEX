      "label": "$n_{\\mathrm{H}}$ (cm$^{-3}$)"
    },
    "series": [
      {
        "y": {
          "column": "Seebeck_abs_uV_K",
          "label": "$|S|$ (µV K$^{-1}$)"
        },
        "property": "seebeck",
        "group_value": "SPB fit",
        "marker": "None",
        "linestyle": "-",
        "line_width": 2.2
      },
      {
        "y": {
          "column": "Seebeck_abs_uV_K",
          "label": "$|S|$ (µV K$^{-1}$)"
        },
        "property": "seebeck",
        "group_value": "data",
        "color": "#e76f6f",
        "marker": "o",
        "marker_size": 11.0,
        "alpha": 0.75,
        "linestyle": "none",
        "line_width": 0.0
      }
    ],
    "xlabel": "$n_{\\mathrm{H}}$ (cm$^{-3}$)",
    "ylabel": "$|S|$ (µV K$^{-1}$)",
    "xscale": "log",
