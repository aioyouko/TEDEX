{
  "name": "temperature_vs_kappa_lattice_kmin",
  "plot": {
    "kind": "line",
    "x": {
      "semantic": "temperature",
      "label": "$T$ (K)"
    },
    "group": {
      "semantic": "sample"
    },
    "series": [
      {
        "y": {
          "column": "Lattice_Thermal_Conductivity",
          "aliases": ["kappa_L", "kL"],
          "label": "$\\kappa_{\\mathrm{L}}$ (W m$^{-1}$ K$^{-1}$)"
        },
        "property": "lattice_thermal_conductivity"
      }
    ],
    "hline": [
      {
        "y": 0.35,
        "label": "$\\kappa_{\\min}$",
        "color": "#444444",
        "linestyle": "--"
      }
    ],
    "xlabel": "$T$ (K)",
    "ylabel": "$\\kappa_{\\mathrm{L}}$ (W m$^{-1}$ K$^{-1}$)",
    "x_major": 100,
    "x_minor": 50,
    "legend": "inside",
    "legend_loc": "upper right"
  },
  "output": {
    "dir": "outputs/figures/flexible",
    "stem": "temperature_vs_kappa_lattice_kmin",
    "formats": ["png", "pdf"],
    "normalized_csv": true,
    "copy_to_data_dir": true
  }
}
